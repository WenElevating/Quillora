<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>WpfMarkdownEditor.Wpf</RootNamespace>
    <PackageId>WpfMarkdownEditor.Wpf</PackageId>
    <Version>0.1.0</Version>
    <Description>WPF Markdown editor control with real-time preview</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfMarkdownEditor.Core\WpfMarkdownEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Embedded Latin body font (Open Sans, SIL Open Font License 1.1 - see Fonts/OpenSans/OFL.txt).
       Declared as Resource so WPF can load it through a pack URI and render the
       document without requiring a system-wide font installation. -->
  <ItemGroup>
    <None Remove="Fonts\OpenSans\**" />
    <Resource Include="Fonts\OpenSans\OpenSans-Regular.ttf" />
    <Resource Include="Fonts\OpenSans\OpenSans-Italic.ttf" />
    <Resource Include="Fonts\OpenSans\OpenSans-Bold.ttf" />
    <Resource Include="Fonts\OpenSans\OpenSans-BoldItalic.ttf" />
    <Resource Include="Fonts\OpenSans\OFL.txt" />
  </ItemGroup>

</Project>
